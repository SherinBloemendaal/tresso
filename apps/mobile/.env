# Development values. The iOS simulator reaches the Docker stack on localhost; the Android emulator needs
# http://10.0.2.2:8080 and a phone the computer's address on the network (override in .env.local).
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_OAUTH_CLIENT_ID=mobile
EXPO_PUBLIC_NATIVE_REDIRECT_URI=tresso://auth/callback
