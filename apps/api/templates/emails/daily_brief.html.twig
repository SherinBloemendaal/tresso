<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily brief</title>
</head>
<body style="margin: 0; padding: 0; background: #F3F4F6; color: #16181D; font-family: 'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif">
<div style="max-width: 640px; margin: 0 auto; padding: 24px 16px">
  <div style="background: #FFFFFF; border-radius: 14px; padding: 24px">
    <p style="margin: 0 0 6px; font-size: 13px; font-weight: 600; color: #256B5D">Informational, mail to just know</p>
    <h1 style="margin: 0 0 6px; font-size: 26px; line-height: 32px">Daily brief</h1>
    <p style="margin: 0 0 18px; font-size: 14px; color: #4A505C">Brief for {{ date }}, made at {{ time }}: {{ count }} {{ count == 1 ? 'conversation' : 'conversations' }}. Nothing below asks anything of you.</p>
    <p style="margin: 0 0 24px"><a href="{{ briefUrl }}" style="display: inline-block; padding: 10px 16px; border-radius: 6px; background: #16181D; color: #FFFFFF; font-size: 14px; font-weight: 600; text-decoration: none">Open the brief to note them</a></p>
    {% for section in sections %}
      <h2 style="margin: 0 0 8px; font-size: 15px">{{ section.name }}</h2>
      <ul style="margin: 0 0 20px; padding: 0; list-style: none; border: 1px solid #E3E5E9; border-radius: 10px">
        {% for entry in section.entries %}
          <li style="padding: 12px 16px;{% if not loop.last %} border-bottom: 1px solid #E3E5E9;{% endif %}">
            <a href="{{ webUrl }}/inbox/{{ entry.threadId }}" style="font-size: 15px; line-height: 22px; color: #16181D; font-weight: 600; text-decoration: none">{{ entry.subject ?: '(no subject)' }}</a>
            {% if entry.snippet %}<div style="font-size: 14px; line-height: 20px; color: #2C3038">{{ entry.snippet }}</div>{% endif %}
            <div style="font-size: 12px; color: #4A505C">{{ entry.from }} &middot; {{ entry.account }}{% if entry.receivedAt %} &middot; {{ entry.receivedAt|date('D j M H:i', zone) }}{% endif %}</div>
          </li>
        {% endfor %}
      </ul>
    {% endfor %}
    <p style="margin: 0; font-size: 13px; color: #4A505C">Noted emails are marked read and archived. <a href="{{ settingsUrl }}" style="color: #2341D6">Brief settings</a></p>
  </div>
</div>
</body>
</html>
